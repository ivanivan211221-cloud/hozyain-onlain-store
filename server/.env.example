PORT=4000
NODE_ENV=development

# Обязательно: PostgreSQL (одна строка).
# Локально после «docker compose up -d» из корня репозитория:
DATABASE_URL=postgres://hozyan:hozyan_local@localhost:5433/hozyan

# Принудительно включить SSL (если провайдер требует, а в URL нет sslmode):
# DATABASE_SSL=true

# Строго проверять TLS-сертификат сервера (по умолчанию для облака — мягкий режим):
# PGSSL_STRICT=true

JWT_SECRET=change_me
CORS_ORIGIN=http://localhost:5173
